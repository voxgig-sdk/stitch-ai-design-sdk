# Entity: design_generation

main: kit: entity: design_generation: {

  alias: field: {}

  fields: [
    {
      name: "colorScheme"
      req: false
      short: "Preferred color scheme for the design"
      type: "`$STRING`"
    }
    {
      name: "components"
      req: false
      short: "Specific UI components to include"
      type: "`$ARRAY`"
    }
    {
      name: "design"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "designId"
      req: false
      short: "Unique identifier for the generated design"
      type: "`$STRING`"
    }
    {
      name: "exportFormats"
      req: false
      short: "Available export formats for the design"
      type: "`$ARRAY`"
    }
    {
      name: "platform"
      req: false
      short: "Target platform for the UI design"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "preview"
      req: false
      short: "URL to preview image of the generated design"
      type: "`$STRING`"
    }
    {
      name: "prompt"
      req: true
      short: "Description of the desired UI design"
      type: "`$STRING`"
    }
    {
      name: "style"
      req: false
      short: "Design style preferences"
      type: "`$STRING`"
    }
    {
      name: "success"
      req: false
      type: "`$BOOLEAN`"
    }
  ]

  name: "design_generation"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/generate"
          segments: [
            {
              lit: "generate"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
